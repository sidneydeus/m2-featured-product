<?php
/** @var \Sidneydeus\FeaturedProduct\Block\FeaturedProduct $block */
$product = $block->getFeaturedProduct();
if (!$product) {
    return;
}
$stockItem = $product->getExtensionAttributes()->getStockItem();
?>
<div class="featured-product" data-product-id="<?= $block->escapeHtmlAttr($product->getId()) ?>">
    <div class="featured-product__content">
        <h2 class="featured-product__title"><?= $block->escapeHtml(__('Featured Product')) ?></h2>
        <div class="featured-product__info">
            <div class="featured-product__image">
                <?= $block->getImage($product, 'product_page_image_medium')->toHtml() ?>
            </div>
            <div class="featured-product__details">
                <strong class="featured-product__name"><?= $block->escapeHtml($product->getName()) ?></strong>
                <?php if ($product->getShortDescription()): ?>
                    <div class="featured-product__description"><?= $product->getShortDescription() ?></div>
                <?php endif; ?>
                <div class="featured-product__price">
                    <?= $block->getProductPrice($product) ?>
                </div>
                <?php if ($stockItem): ?>
                    <div class="featured-product__stock">
                        <span class="stock <?= $stockItem->getIsInStock() ? 'in-stock' : 'out-of-stock' ?>">
                            <?= $stockItem->getIsInStock() ? __('In Stock') : __('Out of Stock') ?>
                        </span>
                        <?php if ($stockItem->getIsInStock() && $stockItem->getQty()): ?>
                            <span class="qty">(<?= $block->escapeHtml((int)$stockItem->getQty()) ?> <?= __('available') ?>)</span>
                        <?php endif; ?>
                    </div>
                <?php endif; ?>
                <div class="featured-product__actions">
                    <a href="<?= $block->escapeUrl($product->getProductUrl()) ?>"
                       class="action primary tocart"
                       title="<?= $block->escapeHtmlAttr(__('View Details')) ?>">
                        <span><?= $block->escapeHtml(__('View Details')) ?></span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>